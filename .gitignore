# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Biographical source material — kept locally, NEVER pushed. Holds the résumé
# PDF, which contains a mobile number and the full Mastercard description.
# There is deliberately no résumé in public/ for the same reason; a redacted
# copy has to be produced by hand before any download link comes back.
/context/
